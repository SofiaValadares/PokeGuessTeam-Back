                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pokeballType\": \"MASTER_BALL\"\n}"
                },
                "url": "{{baseUrl}}/api/pokemon/draw",
                "description": "**MASTER_BALL:** mítico garantido."
              }
            },
