                  { "key": "Accept-Language", "value": "pt-BR" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pokeballType\": \"ULTRA_BALL\"\n}"
                },
                "url": "{{baseUrl}}/api/pokemon/draw",
                "description": "**ULTRA_BALL:** lendário garantido; mítico 1/150."
              }
