                "url": "{{baseUrl}}/api/pokemon/draw",
                "description": "Altere a variável de coleção `pokeballType` (enum Java)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const j = pm.response.json();",
                      "    pm.test(\"Tipo coincide\", () => {",
                      "        pm.expect(j.pokeballType).to.eql(pm.collectionVariables.get(\"pokeballType\"));",
                      "    });",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
