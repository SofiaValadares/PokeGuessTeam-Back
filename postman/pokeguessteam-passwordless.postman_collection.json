                  "pm.test(\"Paginação PC\", () => {",
                  "    pm.expect(body.content).to.be.an(\"array\");",
                  "    pm.expect(body).to.have.property(\"totalElements\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Espécie por número nacional",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "pt-BR" }],
            "url": "{{baseUrl}}/api/pokemon/species/{{pokedexNumber}}",
            "description": "Referência pública de espécie (`PokemonDto`). Variável `pokedexNumber` (ex. 25 = Pikachu). Não requer perfil."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test(\"PokemonDto\", () => {",
                  "    pm.expect(p).to.have.property(\"number\");",
                  "    pm.expect(p).to.have.property(\"name\");",
                  "    pm.expect(p).to.have.property(\"rarity\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sorteio",
          "item": [
            {
              "name": "Draw — POKE_BALL",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Accept-Language", "value": "pt-BR" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pokeballType\": \"POKE_BALL\"\n}"
                },
                "url": "{{baseUrl}}/api/pokemon/draw",
                "description": "**POKE_BALL:** comum (default); raro 1/10; lendário 1/100; mítico 1/500.\n\nConsome 1 unidade. Erro 400 `POKEBALL_INSUFFICIENT` se quantidade 0."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 200 ou 400 sem bolas\", () => {",
                      "    pm.expect([200, 400]).to.include(pm.response.code);",
                      "});",
                      "if (pm.response.code === 200) {",
                      "    const j = pm.response.json();",
                      "    pm.test(\"Draw response\", () => {",
                      "        pm.expect(j.pokeballType).to.eql(\"POKE_BALL\");",
                      "        pm.expect(j).to.have.property(\"rolledRarity\");",
                      "        pm.expect(j.pokemon).to.be.an(\"object\");",
                      "        pm.expect(j).to.have.property(\"newInventoryLine\");",
                      "        pm.expect(j).to.have.property(\"timesObtainedOnLine\");",
                      "    });",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Draw — GREAT_BALL",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Accept-Language", "value": "pt-BR" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pokeballType\": \"GREAT_BALL\"\n}"
                },
                "url": "{{baseUrl}}/api/pokemon/draw",
