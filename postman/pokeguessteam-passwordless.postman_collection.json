              "name": "Draw — variável {{pokeballType}}",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Accept-Language", "value": "pt-BR" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pokeballType\": \"{{pokeballType}}\"\n}"
