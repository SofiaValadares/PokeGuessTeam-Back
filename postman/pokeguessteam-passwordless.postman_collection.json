            "header": [{ "key": "Accept-Language", "value": "pt-BR" }],
            "url": "{{baseUrl}}/api/profile/me",
            "description": "`profileId`, `userId`, `favoritePokemonId`, `favoritePokemonName`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Perfil\", () => {",
                  "    pm.expect(j).to.have.property(\"profileId\");",
                  "    pm.expect(j).to.have.property(\"userId\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Collection (Pokébolas)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "pt-BR" }],
            "url": "{{baseUrl}}/api/profile/collection",
            "description": "Inventário de bolas:\n- `items[]`: `{ pokeballType, quantity }` — tipos `POKE_BALL`, `GREAT_BALL`, `ULTRA_BALL`, `MASTER_BALL`\n- `pokeballFragments` (10 → 1 Poké Ball)\n- `fragmentsPerPokeBall`: 10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Collection\", () => {",
                  "    pm.expect(j.items).to.be.an(\"array\");",
                  "    pm.expect(j).to.have.property(\"pokeballFragments\");",
                  "    pm.expect(j.fragmentsPerPokeBall).to.eql(10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Training team",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "pt-BR" }],
            "url": "{{baseUrl}}/api/profile/training-team",
            "description": "6 slots: `{ slots: [ { slot: 1..6, pokemon: PokemonDto | null } ] }`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"6 slots\", () => {",
                  "    pm.expect(j.slots).to.be.an(\"array\").with.lengthOf(6);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pokedex",
      "description": "Pokédex nacional com flag `registeredInUserPokedex` por espécie. Requer login.",
      "item": [
        {
          "name": "Listar (paginado)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "pt-BR" }],
            "url": {
              "raw": "{{baseUrl}}/api/pokedex?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pokedex"],
              "query": [
                { "key": "page", "value": "0", "description": "Índice base 0" },
                { "key": "size", "value": "20", "description": "Default 20, máx. 100" }
              ]
            },
            "description": "Paginação Spring: `content`, `page`, `size`, `totalElements`, `totalPages`, `first`, `last`.\n\nCada item: `{ pokemon: PokemonDto, registeredInUserPokedex: boolean }`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Paginação\", () => {",
                  "    pm.expect(body.content).to.be.an(\"array\");",
                  "    pm.expect(body).to.have.property(\"totalElements\");",
                  "    pm.expect(body).to.have.property(\"totalPages\");",
                  "});",
                  "if (body.content.length > 0) {",
                  "    pm.test(\"Entrada Pokédex\", () => {",
                  "        const e = body.content[0];",
                  "        pm.expect(e).to.have.property(\"pokemon\");",
                  "        pm.expect(e).to.have.property(\"registeredInUserPokedex\");",
                  "        pm.expect(e.pokemon).to.have.property(\"number\");",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar tudo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "pt-BR" }],
            "url": "{{baseUrl}}/api/pokedex/all",
            "description": "Array completo de `PokedexEntryDto` (ordenado por número nacional). Cuidado com payload grande (~1000 espécies)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pokemon",
      "description": "PC (inventário por linha evolutiva), espécies e sorteio por Pokébola.",
      "item": [
        {
          "name": "PC (inventário paginado)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "pt-BR" }],
            "url": {
              "raw": "{{baseUrl}}/api/pokemon/pc?page=0&size=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pokemon", "pc"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "50", "description": "Default e máx. 50" }
              ]
            },
            "description": "Linhas do PC: `evolutionLineKey`, `members[]`, `rarity`, `level`, `totalXp`, `xpToNextLevel`, `xpForCurrentStep`, `timesObtained`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
