# Copie para .env e ajuste os valores.

AUTH_CODE_SECRET=change-me-in-production

RESEND_API_KEY=
APP_MAIL_FROM=PokeTeamGuess <onboarding@resend.dev>
APP_MAIL_DEV_LOG_ONLY=true
APP_MAIL_DEV_REDIRECT_TO=

DEV_TOOLS_ENABLED=true

# Produção (HTTPS): true
SESSION_COOKIE_SECURE=false

# Socket.io (partidas em tempo real)
SOCKETIO_HOST=0.0.0.0
SOCKETIO_PORT=9092

# Origens permitidas para CORS HTTP (vírgula)
# Dev (default): http://localhost:*,http://127.0.0.1:*,http://192.168.*:*
# Produção: https://app.seudominio.com,https://www.seudominio.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
