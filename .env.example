# Copie para .env (desenvolvimento local) ou defina no painel do host (produção).
# Nunca commite o ficheiro .env.

# --- Banco de dados ---
# Local (Docker):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=password123

# Produção (Neon) — substitua HOST pelo host real do painel Neon:
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=

# --- Segurança ---
AUTH_CODE_SECRET=change-me-in-production-use-long-random-string
SESSION_COOKIE_SECURE=false

# --- E-mail (Resend) ---
RESEND_API_KEY=
APP_MAIL_FROM=PokeTeamGuess <onboarding@resend.dev>
APP_MAIL_DEV_LOG_ONLY=true
APP_MAIL_DEV_REDIRECT_TO=

# --- App ---
DEV_TOOLS_ENABLED=true

# --- CORS (origens separadas por vírgula) ---
# Dev: deixe vazio para usar os defaults locais em application.properties
# Produção: https://poketeamguess.sofiavcav.dev
APP_CORS_ALLOWED_ORIGIN_PATTERNS=

# --- Porta HTTP (Render/Fly definem PORT automaticamente) ---
# PORT=8080
