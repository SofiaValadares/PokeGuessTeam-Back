# Copie para .env (desenvolvimento local) ou defina no painel do host (produção).
# Nunca commite o ficheiro .env.

# --- Banco de dados ---
# Local (Docker):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=password123

# Produção (Neon) — prefira o endpoint *pooled* (-pooler) e sslmode=require:
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST-pooler/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=
# Opcional Hikari (defaults já ajustados a Neon em application.properties):
# SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=5

# --- Segurança ---
AUTH_CODE_SECRET=change-me-in-production-use-long-random-string
SESSION_COOKIE_SECURE=false

# --- E-mail (Resend) ---
RESEND_API_KEY=
APP_MAIL_FROM=PokeTeamGuess <onboarding@resend.dev>
APP_MAIL_DEV_LOG_ONLY=true
APP_MAIL_DEV_REDIRECT_TO=

# --- App ---
DEV_TOOLS_ENABLED=true

# Master admin usernames (comma-separated). Local/secrets only — never commit real nicks.
MASTER_ADMIN_USERNAMES=username_aqui

# --- CORS (origens separadas por vírgula) ---
# Em local: não defina esta variável (comente) para usar os defaults:
# http://localhost:*, http://127.0.0.1:*, http://192.168.*:*
# Linha vazia anula os defaults e provoca "Invalid CORS request".
# Produção: https://poketeamguess.sofiavcav.dev
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=

# --- Pusher Channels (realtime online) ---
# APP_PUSHER_ENABLED=true
# APP_PUSHER_APP_ID=
# APP_PUSHER_KEY=
# APP_PUSHER_SECRET=
# APP_PUSHER_CLUSTER=mt1

# --- Porta HTTP (Render/Fly definem PORT automaticamente) ---
# PORT=8080
